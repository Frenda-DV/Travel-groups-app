{
  "name": "mee-op-reis",
  "version": "0.1.0",
  "private": true,
  "description": "Installeerbare webapp (PWA) voor groepsreizen: programma, praktische informatie en berichten, ook offline.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migreer": "node scripts/migreer.js",
    "org:nieuw": "node scripts/org-aanmaken.js",
    "demo": "node scripts/demo-vullen.js",
    "vercel-build": "node scripts/vercel-build.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=120000 \"e2e/*.test.js\"",
    "test:alles": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "axe-core": "^4.10.2",
    "htm": "^3.1.1",
    "preact": "^10.25.4"
  }
}

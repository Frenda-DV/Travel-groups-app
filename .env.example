# Verbinding van de app. Deze rol mag GEEN eigenaar van de tabellen zijn:
# de app weigert te starten als row-level security omzeild zou worden.
DATABASE_URL=postgres://reisapp_app:app_dev@localhost:5432/reisapp_dev

# Eigenaar van de database: alleen voor `npm run migreer`, `npm run org:nieuw` en `npm run demo`.
DATABASE_ADMIN_URL=postgres://reisapp_owner:owner_dev@localhost:5432/reisapp_dev
# Wachtwoord dat `npm run migreer` aan de app-rol geeft.
APP_DB_PASSWORD=app_dev

# Publiek adres van de app; komt in uitnodigingslinks te staan.
BASIS_URL=http://localhost:3000
PORT=3000

# E-mail via Resend. Zonder sleutel worden mails alleen in de serverlog getoond
# (handig bij ontwikkelen, ongeschikt voor echt gebruik).
RESEND_API_KEY=
MAIL_AFZENDER=Mee op Reis <reis@voorbeeld.nl>
